{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HA: Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "homeassistant.local",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/custom_components/abrp_telemetry",
                    "remoteRoot": "/config/custom_components/abrp_telemetry"
                }
            ],
            "justMyCode": true
        },
        {
            "name": "HA: Remote Attach (localhost)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/custom_components/abrp_telemetry",
                    "remoteRoot": "/config/custom_components/abrp_telemetry"
                }
            ],
            "justMyCode": true
        }
    ]
}
